{
  "name": "adventure-avenue",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aa/client",
    "build": "npm run build -w @aa/client",
    "preview": "npm run preview -w @aa/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine && tsc -p apps/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx packages/engine/scripts/sim.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
